---
import Navbar from './Navbar';   
import Sidebar from './Sidebar'; 
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Fuentes: Titillium Web (F1) + Orbitron (telemetría) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Titillium+Web:ital,wght@0,400;0,600;0,700;0,900;1,700&family=Orbitron:wght@400;700;900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="racing-bg">
    <!-- client:only="react" = se renderiza SOLO en el navegador.
         Evita errores de SSR con Framer Motion y window. -->
    <Navbar client:only="react" />
    <Sidebar client:only="react" />

    <!-- ml-64 en desktop para dejar hueco al sidebar; pt-16 por el navbar -->
    <main class="md:ml-64 pt-16">
      <slot />
    </main>
  </body>
</html>