---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero';
import About from '../components/sections/About';
import Curriculum from '../components/sections/Curriculum';
import Experience from '../components/sections/Experience';
import Contact from '../components/sections/Contact';
---

<Layout title="Alberto García Martín | Ingeniero informático">
  <Hero client:load />

  <!-- 02 · PERFIL PERSONAL -->
  <section id="sobre-mi" class="bg-carbon-light">
    <About client:load />
  </section>

  <!-- 03 · CURRÍCULUM (pegado al perfil: forman el dosier de identidad) -->
  <section id="cv" class="bg-carbon">
    <Curriculum client:only="react" />
  </section>

  <!-- 04 · PROYECTOS (placeholder, lo llenamos proyecto a proyecto) -->
  <section id="proyectos" class="bg-carbon-light">
    <div class="mx-auto max-w-4xl px-5 sm:px-6 py-16 sm:py-20 md:py-28">
      <div class="flex items-center gap-3">
        <span class="font-tech text-f1-red text-sm tracking-[0.3em]">04</span>
        <span class="h-px w-12 bg-f1-red"></span>
        <span class="font-tech text-silver text-sm tracking-[0.3em] uppercase">Proyectos</span>
      </div>
      <h2 class="font-tech text-3xl md:text-5xl font-black mt-6 text-white/25">PRÓXIMAMENTE</h2>
    </div>
  </section>

  <!-- 05 · TRAYECTORIA -->
  <section id="experiencia" class="bg-carbon">
    <Experience client:load />
  </section>

  <!-- 06 · CONTACTO -->
  <section id="contacto" class="bg-carbon-light">
    <Contact client:load />
  </section>
</Layout>