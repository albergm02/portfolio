---
interface Props {
  // 'full' → teal + naranja + azul (Hero)
  // 'teal' → solo teal (cálido, para secciones "humanas")
  // 'orange' → solo naranja (para contacto)
  variant?: 'full' | 'teal' | 'orange';
  // Intensidad global: 'low' | 'medium' | 'high'
  intensity?: 'low' | 'medium' | 'high';
}

const { variant = 'full', intensity = 'medium' } = Astro.props;

// Mapa de opacidades según intensidad
const opacityMap = {
  low: { b1: 0.18, b2: 0.15, b3: 0.06 },
  medium: { b1: 0.35, b2: 0.28, b3: 0.10 },
  high: { b1: 0.55, b2: 0.45, b3: 0.18 },
};

const op = opacityMap[intensity];

// Definimos qué blobs se muestran según la variante
const showBlob2 = variant === 'full' || variant === 'orange';
const showBlob3 = variant === 'full';
---

<div
  class="aurora-bg"
  data-variant={variant}
  style={`--op1: ${op.b1}; --op2: ${op.b2}; --op3: ${op.b3};`}
  aria-hidden="true"
>
  <div class="aurora-blob aurora-blob-1"></div>
  {showBlob2 && <div class="aurora-blob aurora-blob-2"></div>}
  {showBlob3 && <div class="aurora-blob aurora-blob-3"></div>}
</div>

<style>
  .aurora-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .aurora-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    will-change: transform;
  }

  .aurora-blob-1 {
    width: 65vw;
    height: 65vw;
    top: -25%;
    left: -15%;
    background: radial-gradient(circle, #1F7A8C 0%, transparent 70%);
    opacity: var(--op1);
    animation: float1 24s ease-in-out infinite;
  }

  .aurora-blob-2 {
    width: 55vw;
    height: 55vw;
    bottom: -20%;
    right: -15%;
    background: radial-gradient(circle, #C44900 0%, transparent 70%);
    opacity: var(--op2);
    animation: float2 30s ease-in-out infinite;
  }

  .aurora-blob-3 {
    width: 45vw;
    height: 45vw;
    top: 25%;
    left: 35%;
    background: radial-gradient(circle, #BFDBF7 0%, transparent 70%);
    opacity: var(--op3);
    animation: float3 36s ease-in-out infinite;
  }

  @keyframes float1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33%      { transform: translate(15vw, 12vh) scale(1.15); }
    66%      { transform: translate(-6vw, 18vh) scale(0.92); }
  }
  @keyframes float2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50%      { transform: translate(-14vw, -12vh) scale(1.2); }
  }
  @keyframes float3 {
    0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: var(--op3); }
    50%      { transform: translate(-50%, -50%) scale(1.3); opacity: calc(var(--op3) * 1.6); }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora-blob { animation: none; }
  }
</style>