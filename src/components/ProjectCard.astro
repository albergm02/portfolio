---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, description, year, category, stack: techStack, status } = project.data;

const categoryLabels: Record<string, string> = {
  web: 'Web',
  desktop: 'Desktop',
  systems: 'SysAdmin',
  security: 'Security',
  game: 'Game',
  data: 'Data',
};

const statusLabels: Record<string, string> = {
  deployed: 'Desplegado',
  academic: 'Académico',
  wip: 'En desarrollo',
};

const indexStr = String(index + 1).padStart(2, '0');
---

<a
  href={`/proyectos/${project.id}`}
  class="project-card group relative block border border-border-subtle bg-bg-surface/40 hover:bg-bg-surface transition-all duration-500 overflow-hidden"
>
  <!-- Franja superior naranja al hover -->
  <span class="absolute top-0 left-0 h-px w-0 bg-brand-orange group-hover:w-full transition-all duration-700"></span>

  <!-- Esquinas decorativas -->
  <span class="absolute top-0 left-0 w-6 h-6 border-t border-l border-brand-orange/0 group-hover:border-brand-orange/60 transition-colors duration-500"></span>
  <span class="absolute top-0 right-0 w-6 h-6 border-t border-r border-brand-orange/0 group-hover:border-brand-orange/60 transition-colors duration-500"></span>
  <span class="absolute bottom-0 left-0 w-6 h-6 border-b border-l border-brand-orange/0 group-hover:border-brand-orange/60 transition-colors duration-500"></span>
  <span class="absolute bottom-0 right-0 w-6 h-6 border-b border-r border-brand-orange/0 group-hover:border-brand-orange/60 transition-colors duration-500"></span>

  <div class="p-6 lg:p-7 flex flex-col h-full">

    <!-- Cabecera: número + categoría -->
    <div class="flex items-start justify-between mb-6">
      <span class="font-mono text-xs text-brand-orange/80 tracking-wider">
        / {indexStr}
      </span>
      <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-text-muted border border-border-subtle px-2 py-1">
        {categoryLabels[category] ?? category}
      </span>
    </div>

    <!-- Título -->
    <h3 class="font-display text-2xl lg:text-3xl font-bold tracking-tight text-text-primary group-hover:text-brand-orange transition-colors duration-300 mb-3">
      {title}
    </h3>

    <!-- Descripción -->
    <p class="text-sm text-text-muted leading-relaxed mb-6 flex-1">
      {description}
    </p>

    <!-- Stack -->
    <div class="flex flex-wrap gap-1.5 mb-6">
      {techStack.slice(0, 4).map((tech) => (
        <span class="text-[10px] font-mono uppercase tracking-wider text-text-muted bg-bg-elevated border border-border-subtle px-2 py-1">
          {tech}
        </span>
      ))}
      {techStack.length > 4 && (
        <span class="text-[10px] font-mono uppercase tracking-wider text-text-muted px-2 py-1">
          +{techStack.length - 4}
        </span>
      )}
    </div>

    <!-- Footer: año + estado + flecha -->
    <div class="flex items-center justify-between pt-4 border-t border-border-subtle">
      <div class="flex items-center gap-3">
        <span class="text-xs font-mono text-text-muted">{year}</span>
        <span class="w-1 h-1 rounded-full bg-border-subtle"></span>
        <span class="text-xs font-mono text-text-muted">{statusLabels[status] ?? status}</span>
      </div>

      <span class="inline-flex items-center gap-1 text-xs font-medium text-text-muted group-hover:text-brand-orange transition-colors duration-300">
        Ver
        <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </span>
    </div>

  </div>
</a>