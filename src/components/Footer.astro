---
import { site } from '../data/site';

const navLinks = [
  { href: '/', label: 'Inicio' },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/sobre-mi', label: 'Sobre mí' },
];

const socials = [
  {
    href: site.socials.github,
    label: 'GitHub',
    icon: 'github',
  },
  {
    href: site.socials.linkedin,
    label: 'LinkedIn',
    icon: 'linkedin',
  },
  {
    href: `mailto:${site.email}`,
    label: 'Email',
    icon: 'email',
  },
];
---

<footer class="relative overflow-hidden border-t border-border-subtle bg-black">

  <!-- ─── Fondo: cuadrícula sutil + grano ─── -->
  <div
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
    style="
      background-image:
        linear-gradient(rgba(196, 73, 0, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(196, 73, 0, 0.05) 1px, transparent 1px);
      background-size: 80px 80px;
      mask-image: radial-gradient(ellipse at 50% 0%, black 20%, transparent 80%);
      -webkit-mask-image: radial-gradient(ellipse at 50% 0%, black 20%, transparent 80%);
    "
  ></div>
  <div class="absolute inset-0 grain-overlay" aria-hidden="true"></div>

  <!-- ─── Contenido ─── -->
  <div class="relative z-10 max-w-[1500px] mx-auto px-6 lg:px-12 py-16 lg:py-20">

    <!-- Bloque superior: CTA + redes -->
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-10 mb-16">

      <!-- Izquierda: CTA grande -->
      <div>
        <a
        href={`mailto:${site.email}`}
        class="group inline-flex items-center gap-3 font-display text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-none text-text-primary hover:text-brand-orange transition-colors duration-300"
        >
        Hablemos<span class="text-brand-orange group-hover:translate-x-2 transition-transform duration-300 inline-block">.</span>
        </a>
        <p class="mt-6 text-sm font-mono uppercase tracking-[0.25em] text-text-muted">
          {site.role} · Full Stack
        </p>
        <p class="mt-2 text-sm text-text-muted">
          {site.location}
        </p>
      </div>

      <!-- Derecha: redes sociales -->
      <div class="flex items-center gap-3">
        {socials.map((social) => (
          <a
            href={social.href}
            target={social.icon === 'email' ? undefined : '_blank'}
            rel={social.icon === 'email' ? undefined : 'noopener noreferrer'}
            aria-label={social.label}
            class="group relative w-12 h-12 flex items-center justify-center border border-border-subtle text-text-muted hover:border-brand-orange hover:text-brand-orange transition-all duration-300"
          >
            <!-- Esquina superior izquierda -->
            <span class="absolute top-0 left-0 w-3 h-3 border-t border-l border-brand-orange opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></span>
            <!-- Esquina inferior derecha -->
            <span class="absolute bottom-0 right-0 w-3 h-3 border-b border-r border-brand-orange opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></span>

            {social.icon === 'github' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
              </svg>
            )}

            {social.icon === 'linkedin' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            )}

            {social.icon === 'email' && (
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
            )}
          </a>
        ))}
      </div>

    </div>

    <!-- Divisor -->
    <div class="h-px w-full bg-border-subtle mb-8" aria-hidden="true"></div>

    <!-- Bloque inferior: navegación + volver arriba -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">

      <!-- Navegación -->
      <nav aria-label="Navegación del footer">
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-xs font-mono uppercase tracking-[0.2em] text-text-muted hover:text-brand-orange transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Volver arriba -->
      <button
        id="back-to-top"
        type="button"
        class="group inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.2em] text-text-muted hover:text-brand-orange transition-colors"
        aria-label="Volver al inicio de la página"
      >
        <span class="transition-transform duration-300 group-hover:-translate-y-1" aria-hidden="true">↑</span>
        Volver arriba
      </button>

    </div>

  </div>
</footer>

<script>
  const backToTop = document.getElementById('back-to-top');
  if (backToTop) {
    backToTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>